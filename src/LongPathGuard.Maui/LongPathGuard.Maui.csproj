<Project Sdk="Microsoft.NET.Sdk">

		<PropertyGroup>
				<TargetFramework>netstandard2.0</TargetFramework>
				<PackageId>LongPathGuard.Maui</PackageId>
				<Version>1.0.2</Version>
				<Authors>Jeroen</Authors>
				<Company>JeroenTechSolutions</Company>
				<Description>Prevents MSB3026 long path errors in .NET MAUI iOS / MacCatalyst builds from Windows by scanning for risky file paths in any NuGet package.</Description>
				<PackageTags>maui;ios;longpath;msbuild;build-guard;windows</PackageTags>
				<PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
				<PackageReadmeFile>README.md</PackageReadmeFile>
				<RepositoryUrl>https://github.com/grootstebozewolf/LongPathGuard.Maui</RepositoryUrl>
				<RepositoryType>git</RepositoryType>
				<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
				<IncludeBuildOutput>false</IncludeBuildOutput>
				<NoWarn>$(NoWarn);NU5128</NoWarn>
				<PackageIcon>icon.png</PackageIcon>
		</PropertyGroup>

		<ItemGroup>
				<None Include="build\LongPathGuard.Maui.targets" Pack="true" PackagePath="build\" />
				<None Include="build\LongPathGuard.Maui.props" Pack="true" PackagePath="build\" />
				<None Include="..\..\README.md" Pack="true" PackagePath="\" />
				<None Include="icon.png" Pack="true" PackagePath="" />
		</ItemGroup>
</Project>