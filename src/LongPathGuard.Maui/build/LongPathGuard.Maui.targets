<Project>
		<PropertyGroup>
				<LongPathGuardEnabled Condition="'$(LongPathGuardEnabled)' == ''">true</LongPathGuardEnabled>
				<MaxSafePathLength Condition="'$(MaxSafePathLength)' == ''">200</MaxSafePathLength>
				<!-- Release pipelines compile generated C# in-memory / under obj; those files
				     are not copied to the iOS/MacCatalyst payload and are not the MSB3026
				     native-asset case this guard exists for. -->
				<LongPathGuardSkipGenerated Condition="'$(LongPathGuardSkipGenerated)' == ''">true</LongPathGuardSkipGenerated>
		</PropertyGroup>

		<Target Name="LongPathGuard" BeforeTargets="Build;Publish;MauiPrepareForBuild;Restore"
						Condition="'$(LongPathGuardEnabled)' == 'true' AND ($(TargetFramework.Contains('ios')) OR $(TargetFramework.Contains('maccatalyst')))">

				<Message Text="=== LongPathGuard.Maui: Scanning for Windows MAX_PATH risks ===" Importance="High" />

				<ItemGroup>
						<_LpgProjectExclude Include="$(MSBuildProjectDirectory)\bin\**\*" />
						<_LpgProjectExclude Include="$(MSBuildProjectDirectory)\obj\**\*" />
						<_LpgProjectExclude Include="$(MSBuildProjectDirectory)\**\*.g.cs" Condition="'$(LongPathGuardSkipGenerated)' == 'true'" />
						<_LpgProjectExclude Include="$(MSBuildProjectDirectory)\**\*.g.i.cs" Condition="'$(LongPathGuardSkipGenerated)' == 'true'" />
						<_LpgProjectExclude Include="$(MSBuildProjectDirectory)\**\*.g.shared.cs" Condition="'$(LongPathGuardSkipGenerated)' == 'true'" />

						<AllFiles Include="$(MSBuildProjectDirectory)\**\*" Exclude="@(_LpgProjectExclude)" />
						<AllFiles Include="$(NuGetPackageRoot)\**\*" Condition="'$(NuGetPackageRoot)' != ''" />
				</ItemGroup>

				<ItemGroup Condition="'$(LongPathGuardSkipGenerated)' == 'true' AND '@(AllFiles)' != ''">
						<AllFiles Remove="@(AllFiles)" Condition="$([System.String]::Copy('%(Filename)%(Extension)').EndsWith('.g.cs'))" />
						<AllFiles Remove="@(AllFiles)" Condition="$([System.String]::Copy('%(Filename)%(Extension)').EndsWith('.g.i.cs'))" />
						<AllFiles Remove="@(AllFiles)" Condition="$([System.String]::Copy('%(Filename)%(Extension)').EndsWith('.g.shared.cs'))" />
				</ItemGroup>

				<ItemGroup>
						<LongPathFiles Include="@(AllFiles)" Condition="$( [System.String]::Copy('%(FullPath)').Length ) &gt; $(MaxSafePathLength)" />
				</ItemGroup>

							<Error Text="LongPathGuard.Maui FAILURE:

				One or more files exceed the safe Windows path length ($(MaxSafePathLength) characters).
				This commonly triggers MSB3026 or path-too-long errors when building MAUI iOS or MacCatalyst targets from Windows.

				Offending files:
				@(LongPathFiles->'%(FullPath)', ';&#10;')

				Current solution root:
				$(MSBuildProjectDirectory)
				($(MSBuildProjectDirectory.Length) characters)

				Recommended fixes:

				1. Move the solution folder to a short path closer to the drive root
					 (e.g. C:\dev\MyProject\ or D:\src\MyProject\).

				2. Enable Windows long path support:
					 - Set the registry key:
						 HKLM\SYSTEM\CurrentControlSet\Control\FileSystem\LongPathsEnabled = 1 (DWORD)
					 - Reboot the machine

				This guard runs early during Restore / Build / MauiPrepareForBuild to prevent cryptic failures later in the iOS/MacCatalyst pipeline."
										Condition="'@(LongPathFiles)' != ''" />
		</Target>
</Project>
